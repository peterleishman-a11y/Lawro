# Copy to .env and edit. Never commit .env.
PORT=3000
# Where the SQLite file lives.
DATABASE_PATH=./data/lawro.db
# Set to 1 behind a TLS-terminating proxy so session cookies are marked Secure.
SECURE_COOKIES=0
# One-time bootstrap PIN for the first admin. Change or remove after first login.
ADMIN_NAME=Your Name
ADMIN_PIN=
